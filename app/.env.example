# MessMate — Environment variables
# Copy to .env.local and fill with your existing Supabase project values.
# Never commit real keys. Never put the service-role key in NEXT_PUBLIC_*.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy name also supported:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional (future auth callback)
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback
